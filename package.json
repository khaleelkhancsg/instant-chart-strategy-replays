{
  "name": "mnq-chart-lab",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Visual 30-day combine backtester for MNQ 1-minute data — canvas charts, live parameter tuning, $3,000 and $1,250 prop-firm evaluations, indicator studies that gate entries, and an MCP server for research.",
  "scripts": {
    "data:add": "node --disable-warning=ExperimentalWarning store.mjs add",
    "data:pull": "node --disable-warning=ExperimentalWarning store.mjs pull",
    "data:status": "node --disable-warning=ExperimentalWarning store.mjs status",
    "data:build": "node --disable-warning=ExperimentalWarning --max-old-space-size=8192 store.mjs build",
    "data:backup": "node --disable-warning=ExperimentalWarning store.mjs backup",
    "start": "node server.mjs",
    "mcp": "node --max-old-space-size=8192 mcp/server.mjs",
    "test": "node --max-old-space-size=8192 test.mjs",
    "parity": "node --max-old-space-size=8192 test/legacy_parity.mjs",
    "test:mcp": "node test/mcp.test.mjs",
    "test:link": "node test/chart_link.test.mjs",
    "audit": "node audit.mjs",
    "verify-rolls": "node verify_rolls.mjs",
    "verify:tradovate": "node --max-old-space-size=8192 tradovate/verify_1250.mjs",
    "mock": "node --max-old-space-size=8192 tradovate/mock/check.mjs",
    "test:mock": "node test/mock.test.mjs",
    "test:ui": "node --max-old-space-size=4096 test/ui.test.mjs",
    "test:levels": "node --max-old-space-size=4096 test/levels.test.mjs",
    "test:store": "node --disable-warning=ExperimentalWarning test/store.test.mjs",
    "test:data": "node --disable-warning=ExperimentalWarning test/data_routes.test.mjs",
    "test:pull": "python bot/test_pull_topstepx_raw.py",
    "check": "npm test && npm run audit && npm run parity && npm run test:mcp && npm run test:link && npm run test:mock && npm run test:ui && npm run test:levels && npm run test:store && npm run test:data && npm run test:pull && npm run verify:tradovate"
  },
  "engines": { "node": ">=18" }
}
